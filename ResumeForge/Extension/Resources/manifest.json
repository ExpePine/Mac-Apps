{
  "manifest_version": 3,
  "name": "ResumeForge Capture",
  "description": "One click sends the job you're viewing on Naukri, Wellfound or LinkedIn to ResumeForge. The icon shows how many JDs you've sent today.",
  "version": "1.2",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "action": {
    "default_title": "Send this job to ResumeForge",
    "default_icon": {
      "16": "toolbar-16.png",
      "32": "toolbar-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.naukri.com/*",
        "*://*.wellfound.com/*",
        "*://*.linkedin.com/jobs/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "*://*.naukri.com/*",
    "*://*.wellfound.com/*",
    "*://*.linkedin.com/*"
  ],
  "options_ui": {
    "page": "status.html",
    "open_in_tab": true
  }
}