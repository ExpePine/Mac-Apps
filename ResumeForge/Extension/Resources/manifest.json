{
  "manifest_version": 3,
  "name": "ResumeForge Capture",
  "description": "Send the job description you're viewing on Naukri, Wellfound or LinkedIn to the ResumeForge app.",
  "version": "1.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "toolbar-16.png",
      "32": "toolbar-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.naukri.com/*",
        "*://*.wellfound.com/*",
        "*://*.linkedin.com/jobs/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.naukri.com/*",
    "*://*.wellfound.com/*",
    "*://*.linkedin.com/*"
  ]
}